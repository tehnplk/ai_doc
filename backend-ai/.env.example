# AI Document Assignment System - Backend AI

## API Keys
GOOGLE_API_KEY=your_google_api_key_here

## Database (pgvector)
DATABASE_URL=postgresql://user:password@localhost:5433/doc-ai

## Server
HOST=0.0.0.0
PORT=8000
DEBUG=true

## Processing
CHUNK_SIZE=400
CHUNK_OVERLAP=50
TOP_K_CANDIDATES=5
SIMILARITY_THRESHOLD=0.7

## Models
EMBEDDING_MODEL=gemini-embedding-001
LLM_MODEL=gemini-2.5-flash-lite
